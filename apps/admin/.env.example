# ============================================================
# MyDay Super Admin — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase Project ────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — SERVER SIDE ONLY. Never expose to the browser.
# Required for Admin API (listUsers, RBAC role checks, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL (Admin Portal itself) ───────────────────────────
# Your Vercel deployment URL or localhost:3000 in development
NEXTAUTH_URL=https://admin.myday.app
# Set to a strong random string (min 32 chars) for session security
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Cross-App Communication ─────────────────────────────────
# URL of the Web App (for CORS/CSP configuration)
NEXT_PUBLIC_WEB_URL=https://myday.app
