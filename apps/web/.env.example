# ============================================================
# MyDay Web App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Admin Portal URL ────────────────────────────────────────
# Used by the analytics beacon and APK download route to
# fire telemetry events to the Admin Portal's /api/analytics/collect.
# In development: http://localhost:3000 (Admin runs on port 3000)
# In production: your deployed Admin Vercel URL
NEXT_PUBLIC_ADMIN_URL=https://admin.myday.app
ADMIN_URL=https://admin.myday.app

# ── Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://myday.app
